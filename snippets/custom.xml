<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote name="jqk"
           fetch="https://github.com/ddoibuonjqk"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/lineage-22.2" />

    <remote name="gh" fetch="https://github.com" sync-c="true" sync-j="4" />
    <remote name="gl" fetch="https://gitlab.com" sync-c="true" sync-j="4" />

    <!-- build -->
    <project path="build/make" name="android_build" groups="pdk,sysui-studio" remote="jqk" >
        <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
        <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
        <linkfile src="core" dest="build/core" />
        <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
        <linkfile src="target" dest="build/target" />
        <linkfile src="tools" dest="build/tools" />
    </project>
    <project path="build/release" name="android_build_release" groups="pdk,tradefed,sysui-studio" remote="jqk" />

    <!-- bootable -->
    <project path="bootable/recovery" name="android_bootable_recovery" groups="pdk" remote="jqk" />

    <!-- frameworks -->
    <project path="frameworks/base" name="android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="jqk" />

    <!-- lineage-sdk -->
    <project path="lineage-sdk" name="android_lineage-sdk" remote="jqk" />

    <!-- packages -->
    <project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="jqk" />
    <project path="packages/apps/SetupWizard" name="android_packages_apps_SetupWizard" remote="jqk" />
    <project path="packages/apps/Settings" name="android_packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc" remote="jqk" />
    <project path="packages/apps/Trebuchet" name="android_packages_apps_Trebuchet" groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="jqk" />
    <project path="packages/apps/Updater" name="android_packages_apps_Updater" remote="jqk" />
    <project path="packages/apps/FaceUnlock" name="Evolution-X/packages_apps_FaceUnlock" remote="gh" revision="refs/heads/vic" />

    <!-- system -->
    <project path="system/sepolicy" name="android_system_sepolicy" groups="pdk" remote="jqk" />

    <!-- vendor -->
    <project path="vendor/lineage" name="android_vendor_lineage" remote="jqk" />
    <project path="vendor/lineage-priv/keys" name="android_vendor_lineage-priv_keys" remote="jqk" revision="refs/heads/main" />
    <project path="vendor/gapps" name="MindTheGapps/vendor_gapps" remote="gl" revision="refs/heads/vic" />

</manifest>
